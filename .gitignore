# ---------------------------------------------------------------------------
# Secrets — nothing in this block may ever reach the public repository.
# The assignment (PDF section 9) explicitly forbids committing connection URIs
# or passwords; credentials are read from environment variables only.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*credentials*.txt
*credentials*.json
*.pem
*.key

# ---------------------------------------------------------------------------
# Dataset artifacts — regenerable from scripts/prepare_dataset.py, and far too
# large to version. The sha256 manifest is committed instead, so a reviewer can
# verify they built the identical dataset.
# ---------------------------------------------------------------------------
data/raw/
data/prepared/*
!data/prepared/manifest.json

# ---------------------------------------------------------------------------
# Benchmark output — raw per-operation samples are large. Aggregated results
# (results.json / results.csv / charts) ARE committed: they are the deliverable.
# ---------------------------------------------------------------------------
results/raw/*
# ...except the two runs the README reports, so a reviewer can recompute any
# percentile from the individual samples (564 KB total).
!results/raw/lab-final/
!results/raw/cloud-final/

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
*.egg-info/
.coverage
htmlcov/

# ---------------------------------------------------------------------------
# Editors / OS
# ---------------------------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# ---------------------------------------------------------------------------
# Not part of the submission: the assignment brief itself, local planning
# notes, the leftover .git of the pre-flatten nested repo, and the loose copies
# of the SNAP source files (byte-identical duplicates of data/raw/).
# ---------------------------------------------------------------------------
OVERVIEW.md
*.pdf
cognodb-benchmark/
data/*.txt
