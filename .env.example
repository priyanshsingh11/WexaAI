# ---------------------------------------------------------------------------
# Copy to .env and fill in. .env is gitignored and must never be committed.
#
#   cp .env.example .env
#
# Every credential the harness uses is read from this file via python-dotenv.
# No connection URI or password appears anywhere in the source tree.
# ---------------------------------------------------------------------------

# --- CognoDB Cloud (free c0 tier) ------------------------------------------
# From the CognoDB console. The password is shown exactly once at instance
# creation; if you lost it, regenerate the instance credentials.
COGNODB_URI=bolt+s://<instance-id>.databases.cognodb.cloud
COGNODB_USER=cognodb
COGNODB_PASSWORD=

# --- Neo4j Community 5 (local Docker, capped 0.5 vCPU / 256 MB) ------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=benchmark_local_only

# --- Memgraph (local Docker, capped 0.5 vCPU / 256 MB) ---------------------
# Memgraph's default Docker image runs without auth; user/password are left
# blank and the adapter connects anonymously.
MEMGRAPH_URI=bolt://localhost:7688
MEMGRAPH_USER=
MEMGRAPH_PASSWORD=

# --- FalkorDB (local Docker, capped 0.5 vCPU / 256 MB) ---------------------
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_PASSWORD=

# --- ArangoDB (local Docker, capped 0.5 vCPU / 256 MB) ---------------------
ARANGO_URL=http://localhost:8529
ARANGO_USER=root
ARANGO_PASSWORD=benchmark_local_only
ARANGO_DB=citations

# --- Neo4j AuraDB Free (optional managed-cloud cross-check) ----------------
# Used only to separate "engine differences" from "managed-cloud delivery
# overhead". Leave blank to skip this target entirely.
NEO4J_AURA_URI=
NEO4J_AURA_USER=neo4j
NEO4J_AURA_PASSWORD=

# --- Benchmark determinism --------------------------------------------------
# Seeds the dataset sample and the start-node selection. Changing this changes
# which nodes are queried, so results across different seeds are not comparable.
BENCH_SEED=42
